<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#1E293B"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- বাম পাশের ছবি -->
    <ImageView
        android:id="@+id/notification_custom_img"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:src="@drawable/abir_pic" />

    <!-- মাঝের টেক্সট -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_custom_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="মিউজিক প্লেয়ার"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_custom_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ব্যান্ড ট্র্যাক - লাইভ প্লে হচ্ছে"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ডান পাশের বাটন -->
    <!-- ডান পাশের বাটন -->
    <ImageButton
        android:id="@+id/notification_custom_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_play"
        android:tint="#38BDF8"
        android:contentDescription="Play/Pause" />

</LinearLayout>